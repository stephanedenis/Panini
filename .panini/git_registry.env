# Git Registry Configuration
# Panini Git-native data storage

# Enable/disable local SQLite cache
ENABLE_CACHE=true

# Repository configuration
ANALYSES_DIR=analyses
PANINI_CONFIG_DIR=.panini
CACHE_DB_PATH=.panini/panini.db

# Token encryption (optional)
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Git commit messages
GIT_COMMIT_AUTHOR=Panini
GIT_COMMIT_EMAIL=panini@github.local

# Analysis retention (optional - for cleanup operations)
KEEP_ANALYSES_DAYS=365
