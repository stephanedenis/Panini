# Panini ColabMCP Configuration
# Copy to .env and fill in your actual values

# Google OAuth2
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback

# Google Colab API
COLAB_API_URL=https://colab.research.google.com/api/ml/v1

# GitHub
GITHUB_TOKEN=ghp_your_token_here
GITHUB_OWNER=your_username_or_org
GITHUB_REPO=Panini  # Main repository

# Database (AttributionRegistry)
DATABASE_URL=postgresql://user:password@localhost/panini_registry

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=http  # or 'mcp'

# Logging
LOG_LEVEL=INFO

# Colab defaults
DEFAULT_MACHINE_TYPE=L4
DEFAULT_TIMEOUT=3600

# Analysis settings
MAX_CONCURRENT_ANALYSES=5
MAX_ANALYSIS_DURATION_HOURS=24
