# Panini ColabMCP Development Configuration
# For local testing and development

# Environment
ENV=development
LOG_LEVEL=DEBUG

# Google OAuth2 (Development - these are placeholders)
GOOGLE_CLIENT_ID=dev-client-id-xxx
GOOGLE_CLIENT_SECRET=dev-client-secret-xxx
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/callback

# GitHub (Development - use personal token for testing)
GITHUB_TOKEN=ghp_dev_token_placeholder
GITHUB_OWNER=stephanedenis

# Google Colab API
COLAB_API_URL=https://colab.research.google.com/api/ml/v1

# MCP Server
MCP_SERVER_URL=http://localhost:8080

# Database (Local SQLite for development)
DATABASE_URL=sqlite:///./panini_dev.db

# Colab Configuration
DEFAULT_MACHINE_TYPE=L4
MAX_COMPUTE_HOURS=24.0
